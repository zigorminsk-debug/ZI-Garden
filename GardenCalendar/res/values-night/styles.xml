<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Тёмная тема: тот же каркас на тёмной базе Material; все цвета берутся из values-night. -->
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:textColorPrimary">@color/text_main</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorPrimary">@color/green_900</item>
        <item name="android:colorPrimaryDark">@color/bar</item>
        <item name="android:colorAccent">@color/green_700</item>
        <item name="android:statusBarColor">@color/bar</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
