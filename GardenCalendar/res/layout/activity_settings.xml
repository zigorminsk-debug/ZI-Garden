<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍 Участок (город / координаты)"
            android:textColor="@color/green_700"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/city"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/lat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Широта"
                android:inputType="numberDecimal|numberSigned" />

            <EditText
                android:id="@+id/lon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:hint="Долгота"
                android:inputType="numberDecimal|numberSigned" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_gps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📡 Определить моё местоположение по GPS"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/save_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Сохранить участок"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/region_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_bg"
            android:lineSpacingExtra="3dp"
            android:padding="10dp"
            android:textColor="@color/text_main"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="🌳 Возраст ваших растений (влияет на дозы)"
            android:textColor="@color/green_700"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/size_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/size_young"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Молодые (до 5 лет)" />

            <RadioButton
                android:id="@+id/size_medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Плодоносящие (5–15 лет)" />

            <RadioButton
                android:id="@+id/size_old"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Взрослые, крупные (старше 15 лет)" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="🔠 Размер шрифта"
            android:textColor="@color/green_700"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/font_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/font_small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Мелкий"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/font_normal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Обычный" />

            <RadioButton
                android:id="@+id/font_large"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Крупный"
                android:textSize="17sp" />

            <RadioButton
                android:id="@+id/font_xlarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Очень крупный"
                android:textSize="20sp" />

            <RadioButton
                android:id="@+id/font_xxlarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Огромный"
                android:textSize="23sp" />

            <RadioButton
                android:id="@+id/font_xxxlarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Гигантский"
                android:textSize="26sp" />
        </RadioGroup>

        <TextView
            android:id="@+id/font_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Образец: такие подписи будут во всех разделах приложения — задачи, календарь, справочники. Размер применяется сразу."
            android:textColor="@color/text_sub"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="🔔 Напоминания"
            android:textColor="@color/green_700"
            android:textSize="16sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/notify_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Присылать напоминания о работах" />

        <Button
            android:id="@+id/notify_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAllCaps="false" />

        <CheckBox
            android:id="@+id/weekly_digest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Еженедельный дайджест (воскресенье 10:00 — план работ на неделю)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Напоминать:"
            android:textColor="@color/text_sub"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/lead"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/test_notify"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Проверить уведомление"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/notify_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_sub"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="🧹 Данные"
            android:textColor="@color/green_700"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/reset_year"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Сбросить отметки «выполнено» за этот год"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/clear_bought"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Очистить список покупок"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="💾 Резервная копия"
            android:textColor="@color/green_700"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="👨‍👩‍👧 Семья (Gmail)"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/family_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Общий e-mail семьи (например, semya@gmail.com)"
            android:inputType="textEmailAddress" />

        <Button
            android:id="@+id/family_send"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📨 Отправить данные семье по e-mail"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Как это работает: вы отправляете свою копию одним нажатием — на другом телефоне её импортируют: прямо текстом из письма или тапом по .json-вложению из Gmail (наше приложение зарегистрировано приёмником таких файлов). Кто последний отправил — тот и «главный»: у всех одинаковые культуры, отметки и журнал."
            android:textColor="@color/text_sub"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="☁️ Онлайн — общий сад у всей семьи"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/sync_server"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Адрес сервера (обычно менять не нужно)"
            android:inputType="textUri" />

        <Button
            android:id="@+id/sync_create"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="➕ Создать семью на сервере"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/sync_join"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔗 Присоединиться к семье (логин + пароль)"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/sync_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔄 Синхронизировать сейчас"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/sync_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_sub"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="🗂 На этом устройстве"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/backup_export"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Экспорт всех данных в файл"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/backup_import"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Импорт данных из файла"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Сохраните файл перед переустановкой приложения или сменой телефона — потом вернёте культуры, отметки «выполнено», журнал и настройки. Импорт полностью заменяет текущие данные."
            android:textColor="@color/text_sub"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
