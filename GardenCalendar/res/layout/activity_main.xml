<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_main"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/weather_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_main"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/forecast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/card_bg"
            android:lineSpacingExtra="3dp"
            android:padding="10dp"
            android:textColor="@color/text_main"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/weather_updated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/text_sub"
            android:textSize="11sp" />

        <!-- Единое верхнее меню: равные плитки с пиктограммами -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_weather"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_weight="1"
                android:background="@drawable/card_bg"
                android:gravity="center"
                android:padding="4dp"
                android:text="🔄\nПогода"
                android:textAllCaps="false"
                android:textColor="@color/text_main"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_gps"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/card_bg"
                android:gravity="center"
                android:padding="4dp"
                android:text="📡\nGPS"
                android:textAllCaps="false"
                android:textColor="@color/text_main"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_plants"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/card_bg"
                android:gravity="center"
                android:padding="4dp"
                android:text="🌿\nРастения"
                android:textAllCaps="false"
                android:textColor="@color/text_main"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_tasks"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/card_bg"
                android:gravity="center"
                android:padding="4dp"
                android:text="✅\nЗадачи"
                android:textAllCaps="false"
                android:textColor="@color/text_main"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_calendar"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_weight="1"
                android:background="@drawable/card_bg"
                android:gravity="center"
                android:padding="4dp"
                android:text="🗓️\nКалендарь"
                android:textAllCaps="false"
                android:textColor="@color/text_main"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_materials"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/card_bg"
                android:gravity="center"
                android:padding="4dp"
                android:text="🧪\nПокупки"
                android:textAllCaps="false"
                android:textColor="@color/text_main"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_soil"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/card_bg"
                android:gravity="center"
                android:padding="4dp"
                android:text="🌱\nПочва"
                android:textAllCaps="false"
                android:textColor="@color/text_main"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_pests"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/card_bg"
                android:gravity="center"
                android:padding="4dp"
                android:text="🐛\nВредители"
                android:textAllCaps="false"
                android:textColor="@color/text_main"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_diseases"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_weight="1"
                android:background="@drawable/card_bg"
                android:gravity="center"
                android:padding="4dp"
                android:text="🍂\nБолезни"
                android:textAllCaps="false"
                android:textColor="@color/text_main"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_settings"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/card_bg"
                android:gravity="center"
                android:padding="4dp"
                android:text="⚙️\nНастройки"
                android:textAllCaps="false"
                android:textColor="@color/text_main"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_about"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/card_bg"
                android:gravity="center"
                android:padding="4dp"
                android:text="ℹ️\nО программе"
                android:textAllCaps="false"
                android:textColor="@color/text_main"
                android:textSize="11sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/text_main"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/plants_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_sub"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/tasks_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="Захаревич Игорь · +375 29 337-14-12 · csl.by"
            android:textColor="@color/text_sub"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
