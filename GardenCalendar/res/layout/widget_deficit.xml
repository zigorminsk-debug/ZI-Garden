<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_d_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/card_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_d_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔬 Минерал дня"
            android:textColor="@color/green_900"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_d_date"
            android:text="сегодня"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="@color/text_sub"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_d_signs"
            android:text="Бор (B) — точка роста отмирает или искривляется, молодые листья мелкие уродливые"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/text_main"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/widget_d_fix"
            android:text="💊 Борная кислота 0,02–0,05% (2–5 г на ведро) по листу."
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_sub"
        android:textSize="13sp" />
</LinearLayout>
