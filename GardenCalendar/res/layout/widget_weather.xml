<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/card_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_w_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🌡️ Погода для сада"
            android:textColor="#1B5E20"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_w_date"
            android:text="сегодня"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="#5C6660"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_w_now"
            android:text="⛅ +18° · переменная облачность"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#20271F"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/widget_w_today"
            android:text="Сегодня: дождь к вечеру, +12…+19°"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="#20271F"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_w_advice"
            android:text="Хороший день для полива"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#1B5E20"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
